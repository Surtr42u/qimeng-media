# ===== qimeng-media monorepo =====

# 依赖与构建产物
node_modules/
dist/
build/
*.exe
# Windows 下 exe 被占用重建时 go build 留下的旧版备份（rename 残留）
*.exe~
*.dll
*.so
*.dylib

# Go
server/bin/
server/tmp/
coverage.out
*.test

# SQLite 本地开发库与数据
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
/data/

# 本地运行数据目录（数据库+缩略图+直链签名密钥，严禁入库）
qimeng-data/

# Mimosa 钩子产物
.mimosa/

# 前端
web/dist/
web/.vite/
*.local

# Android（build 目录多模块通配：app/core/feature 各模块一律忽略）
android/.gradle/
android/**/build/
android/local.properties
*.apk
*.aab
*.keystore
!debug.keystore

# IDE 与系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 环境与密钥（配置模板可提交，真实配置不提交）
.env
config/*.local.yaml

# 日志
*.log

# 协议生成物（make sdk 随时重建，不入库；仅生成器配置入库）
server/internal/httpapi/gen/*.gen.go
web/src/api/generated/
android/sdk/
.openapi-generator/

# 服务端运行时数据目录（临时配置启动时产生，非 qimeng-data 正式数据目录）
server/data/

# 运行截图（可能含真实媒体帧，永不入库；存证放仓库外 run-screens-* 目录）
.run-screens/

# IDE 运行配置目录（曾混入截图，同上永不入库；任务V V2 审查 P3-2 加盖）
.run/
