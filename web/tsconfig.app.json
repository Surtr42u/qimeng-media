{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    // 显式声明严格模式：TS 6.0 已默认 strict，但项目定论是 TypeScript(strict)，显式写出避免依赖编译器默认值
    "strict": true,
    // shadcn/ui 组件统一用 @/ 别名导入；TS 6.0 已废弃 baseUrl，paths 用相对路径即可生效
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
