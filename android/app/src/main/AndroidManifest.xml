<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 访问 NAS 服务端（局域网 http）必需；M4-1 起有真实网络请求（探活/登录） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 上传进度/完成通知（M4-5）：API 33+ 运行时申请，未授权只影响可见性不阻断上传 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- FGS 权限与 dataSync 类型声明在 :core:data（setForeground 使用方模块，随清单合并） -->

    <!-- 内嵌服务端读媒体库根（ADR-0015 单机形态，2026-09-15 批）：注册库走「手输绝对路径→
         服务端直读文件系统」的 NAS 范式，scoped storage 下唯有 ALL FILES ACCESS 能放行
         （媒体三权限只覆盖 MediaStore 索引项，.nomedia 隐藏目录内的文件读不到——手机实测
         376 文件在册、服务端直读 0）。声明本权限后系统设置「所有文件访问」开关才可拨；
         授权引导入口在设置→服务器（本机模式）。安全面=单设备本地存储读取，不出网
         （ADR-0015 回环红线），对本地媒体库 App 属正当用途（ADR-0015 风险节原文拍板）。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".QimengApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Qimeng"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <!-- 3c 遗留：全屏旋转重建 Activity 会杀播放器；声明后旋转不重建，Compose 自处理
                 （3b 沉浸同样受益：旋转不再触发系统栏状态重置）
                 uiMode（#42，任务V V4）：日夜切换属于 uiMode 配置变化，未声明时系统会
                 销毁重建 MainActivity，导致导航栈重置回首页、详情页丢失。声明后由
                 Activity 原地 onConfigurationChanged 承接，Compose LocalConfiguration
                 更新触发主题重组就地换肤，导航栈原样保留。模拟器实测（qimeng_api35）：
                 cmd uimode night yes/no 切换期间 MainActivity 无 onDestroy/onCreate，
                 详情页与返回栈保留、日夜两态主题正确跟随。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统分享接收（M4-5 上传入口①）：图片/视频的单个与批量分享 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- WorkManager 自定义初始化（M4-5）：Application 实现 Configuration.Provider，
             必须移除默认初始化器（官方 custom-configuration 文档口径，lint 规则
             RemoveWorkManagerInitializer 同样要求） -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
