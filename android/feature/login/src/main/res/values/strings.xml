<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 登录页文案（M4-1）。资源名 login_ 前缀避免与 :app 及其他 feature 模块合并冲突。 -->
    <string name="login_title">登录绮梦影库</string>

    <string name="login_server_url_label">服务器地址</string>
    <!-- 占位示例即冻结规格：http://192.168.x.x:8420；localhost/127.0.0.1 形式同样合法（规范化在 core ServerAddress） -->
    <string name="login_server_url_placeholder">http://192.168.x.x:8420</string>
    <string name="login_password_label">密码（开发模式服务器可留空）</string>
    <string name="login_submit">登录</string>

    <!-- 登录端两选项（第三百六十三笔，用户拍板：外部登录只留「服务器/本机」两个选项；
         地址值来自记忆槽/预设常量由屏幕层展示，文案不嵌地址字面量；login_fill_local_mode
         随快捷填入入口一并退役） -->
    <string name="login_option_server">服务器</string>
    <string name="login_option_local">本机</string>

    <!-- 错误文案（LoginError 分类映射；「地址不通」与「密码错」必须分开，M4-1 冻结口径） -->
    <string name="login_error_invalid_address">服务器地址格式不正确，请检查后重试</string>
    <string name="login_error_server_unreachable">地址不通：无法连接服务器，请检查地址与网络</string>
    <string name="login_error_wrong_password">密码错误，请重新输入</string>
    <string name="login_error_dev_unavailable">该服务器未开启免密模式，请输入密码登录</string>
    <string name="login_error_other">登录失败，请稍后重试</string>

    <!-- 局域网权限被拒引导（任务P P4b，ADR-0022）：Android 17+ 连 NAS 必需，拒绝则不出网直接引导去系统设置 -->
    <string name="login_error_local_network_denied">连接局域网 NAS 需要「本地网络」权限：请在系统设置 → 应用 → 绮梦影库 → 权限中允许后重试</string>
</resources>
